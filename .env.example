# ============================================================
# dbloom 配置文件模板（.env.example）
# ------------------------------------------------------------
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略（不入库），
#       本模板入库，供团队/部署对号入座。
# 加载规则：dbloom-server 启动时自动读取工作目录下的 .env
#       （dotenvy）；「系统已存在的环境变量」优先于 .env 中的同名项，
#       docker/k8s 场景用环境变量注入即可（见 docs/design/05-deploy.md §4）。
# 决策依据：docs/design/00-overview.md 决策清单（D 编号引用如 D10/D19）。
# ============================================================

# ---- 角色（D1/D11：master+worker 同一镜像按角色启动）----
# master | worker。单机最小部署 = master（自带执行，本地开发用）；
# worker 为纯执行节点，不连元数据库。
DBLOOM_ROLE=master

# ---- 元数据库连接（D10：外部关系数据库，默认 MySQL，PG 可切）----
# master 必填。compose/k8s 指向集群内元数据库 service 名；
# 本地开发指向 localhost。缺省回落 mysql://root@localhost:3306/dbloom。
DB_DSN=mysql://root:change_me@127.0.0.1:3306/dbloom

# ---- JWT 签名密钥（D19；生产必须注入，缺省 dev 值并启动告警）----
# 生成随机值示例： openssl rand -hex 32
DBLOOM_JWT_SECRET=dev-insecure-jwt-secret-change-me

# ---- 主密钥文件（数据保护：连接凭据 AES-GCM 加密的主密钥）----
# 生产必填，指向密钥文件路径（文件内容 = 密钥本身）；M1 凭据加密启用。
# DBLOOM_SECRET_KEY_FILE=/etc/dbloom/secrets/master.key

# ---- 共享数据根（D10：日志 / 文件 / custom-jar / checkpoint 均落共享卷）----
# 默认 /dbloom-data；本地开发可改为 ./data。
# DBLOOM_DATA_ROOT=/dbloom-data

# ---- dbloom-server HTTP 端口（对外；Web UI 由它托管）----
# 默认 8081。内部各节点/浏览器入口；TLS 由外部网关终止（D15）。
DBLOOM_HTTP_PORT=8081

# ---- 引擎 REST 端口（仅内部，不对外暴露）----
# SeaTunnel 引擎 master 的 REST/UI；dbloom 经它提交任务（LOCAL）。
SEATUNNEL_HTTP_PORT=8080

# ---- 日志级别（D22）----
# RUST_LOG=info,dbloom_server=debug
